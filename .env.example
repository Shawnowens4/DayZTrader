# Copy this file to .env for the local Docker demo.
# Do not commit .env. Change database values together if you customize them.
POSTGRES_USER=dxemb
POSTGRES_PASSWORD=dxemb_dev_password
POSTGRES_DB=dxemb
DATABASE_URL=postgresql://dxemb:dxemb_dev_password@db:5432/dxemb

# The browser demo does not require the bot. Leave these blank unless starting it.
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:5000/auth/callback
