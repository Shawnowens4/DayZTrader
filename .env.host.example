# Copy to .env.host on the server and replace every CHANGE_ME value.
# Keep this file out of source control. URL-encode special password characters
# in DATABASE_URL.
POSTGRES_USER=dxemb
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
POSTGRES_DB=dxemb
DATABASE_URL=postgresql://dxemb:CHANGE_ME_LONG_RANDOM_PASSWORD@db:5432/dxemb

# Bind to loopback when Caddy/Nginx runs on the same host.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=5000
